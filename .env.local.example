# .env.local.example — Copy to .env.local untuk development
# Jangan commit .env.local ke Git!

# ── Database ──────────────────────────────────────────────────────────────────
# Dev lokal: connect langsung ke PostgreSQL (tanpa PgBouncer)
# Jalankan dulu: docker compose up -d postgres
DATABASE_URL=postgresql://nawavault:YOUR_PASSWORD@localhost:5432/nawavault

# Jika PostgreSQL di VPS dan mau dev dari lokal via tunnel:
# ssh -L 5432:localhost:5432 user@IP_VPS_KAMU
# DATABASE_URL=postgresql://nawavault:YOUR_PASSWORD@localhost:5432/nawavault

# SSL — false untuk dev lokal, true jika PostgreSQL punya SSL cert
DATABASE_SSL=false

# ── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=GENERATE_DENGAN_PERINTAH_INI__openssl_rand_-base64_32
