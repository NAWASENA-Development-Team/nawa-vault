# ──────────────────────────────────────────────────────────────────
# NAWA-VAULT — VPS Environment Variables
# Salin file ini ke .env di folder yang sama dengan docker-compose.yml
# JANGAN commit file ini ke Git!
# ──────────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_DB=nawavault
POSTGRES_USER=nawavault
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT_DISINI

# Database URL untuk aplikasi (via PgBouncer)
# Format: postgresql://user:password@host:port/database
# Di production (Netlify), ini diisi dengan IP publik VPS kamu
DATABASE_URL=postgresql://nawavault:GANTI_DENGAN_PASSWORD_KUAT_DISINI@IP_VPS_KAMU:5432/nawavault
